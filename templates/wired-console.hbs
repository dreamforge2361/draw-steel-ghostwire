<div class="wc-deck">
  <header class="wc-header">
    <span class="wc-sigil"><i class="fa-solid fa-network-wired"></i></span>
    <span class="wc-scene">{{sceneName}}</span>
    {{#if isGM}}{{#if wiredMap}}
    <label class="wc-wired-map" data-tooltip="GHOSTWIRE.WiredConsole.WiredMapHint">
      <i class="fa-solid fa-map-location-dot"></i> {{localize "GHOSTWIRE.WiredConsole.WiredMapFor"}}
      <select class="wc-input" data-wired-map>
        <option value="">{{localize "GHOSTWIRE.WiredConsole.ThisScene"}}</option>
        {{#each wiredMap.options}}<option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    {{/if}}{{/if}}
    <span class="wc-mode">{{#if isGM}}{{localize "GHOSTWIRE.WiredConsole.DirectorMode"}}{{else}}{{localize "GHOSTWIRE.WiredConsole.PlayerMode"}}{{/if}}</span>
    {{#if isGM}}
    <button type="button" class="wc-btn wc-btn-danger" data-action="resetBoard" {{disabled (not hasScene)}}>
      <i class="fa-solid fa-trash-can"></i> {{localize "GHOSTWIRE.WiredConsole.ResetBoard"}}
    </button>
    {{/if}}
  </header>

  <div class="wc-body">
    {{!-- B117: all nine Matrix Verbs. Players fire these from the node they're facing; this strip is the Director roster path. --}}
    <section class="wc-panel wc-verbs">
      <h3 class="wc-panel-title">{{localize "GHOSTWIRE.WiredConsole.Verbs"}}</h3>
      <p class="wc-dim wc-verb-hint">{{localize "GHOSTWIRE.WiredConsole.VerbPlayerPath"}}</p>
      <p class="wc-verb-status">
        {{#if verbActor}}
        <span class="wc-roster-name">{{verbActor.name}}</span>
        <span class="wc-state-chip state-{{verbActor.state}}">{{verbActor.stateLabel}}</span>
        {{else}}
        <span class="wc-dim">{{localize "GHOSTWIRE.WiredConsole.VerbNeedActor"}}</span>
        {{/if}}
        {{#if selected}}<span class="wc-tag">{{selected.name}}</span>{{/if}}
      </p>
      <div class="wc-verb-strip">
        {{#each verbs}}
        <button type="button" class="wc-btn wc-verb" data-action="fireVerb" data-verb="{{dsid}}" {{disabled (not enabled)}} data-tooltip="{{tooltip}}">
          <i class="fa-solid {{icon}}"></i> {{label}}
        </button>
        {{/each}}
      </div>
      {{#if verbHint}}<p class="wc-dim wc-verb-hint">{{verbHint}}</p>{{/if}}
    </section>

    {{!-- Connection roster --}}
    <section class="wc-panel wc-roster">
      <h3 class="wc-panel-title">{{localize "GHOSTWIRE.WiredConsole.Roster"}}</h3>
      <ul class="wc-roster-list">
        {{#each roster}}
        <li class="wc-roster-row state-{{state}}{{#if selected}} selected{{/if}}{{#if isNode}} is-node{{/if}}" data-action="selectActor" data-actor-uuid="{{uuid}}" data-is-node="{{#if isNode}}true{{else}}false{{/if}}" data-node-id="{{nodeId}}" {{#if isNode}}data-tooltip="GHOSTWIRE.WiredConsole.RosterNodeHint"{{/if}}>
          <img src="{{img}}" alt="">
          <span class="wc-roster-name" title="{{name}}" data-tooltip="{{name}}">{{name}}</span>
          <span class="wc-state-chip state-{{state}}">{{stateLabel}}</span>
        </li>
        {{else}}
        <li class="wc-empty">{{localize "GHOSTWIRE.WiredConsole.NoTokens"}}</li>
        {{/each}}
      </ul>
    </section>

    {{!-- Constructs (B121): sprites + Agents. Separate from Connections/Nodes; no graph edges. --}}
    <section class="wc-panel wc-constructs">
      <h3 class="wc-panel-title" data-tooltip="GHOSTWIRE.WiredConsole.Constructs.Hint">{{localize "GHOSTWIRE.WiredConsole.Constructs.Title"}}</h3>
      <p class="wc-dim wc-construct-hint">{{localize "GHOSTWIRE.WiredConsole.Constructs.LockA"}}</p>
      <ul class="wc-construct-list">
        {{#each constructs}}
        <li class="wc-construct-row kind-{{kind}}{{#if anchored}} is-anchored{{/if}}" data-action="selectConstruct" data-actor-uuid="{{uuid}}" data-tooltip="{{panTooltip}}">
          <img src="{{img}}" alt="">
          <div class="wc-construct-body">
            <div class="wc-construct-head">
              <span class="wc-roster-name" title="{{name}}" data-tooltip="{{name}}">{{name}}</span>
              <span class="wc-tag kind-{{kind}}">{{kindLabel}}</span>
            </div>
            <div class="wc-construct-meta">
              {{#if archetypeLabel}}<span class="wc-tag" data-tooltip="{{archetypeLabel}}">{{archetypeLabel}}</span>{{/if}}
              {{#if bandLabel}}<span class="wc-tag" data-tooltip="{{bandLabel}}">{{bandLabel}}</span>{{/if}}
              <span class="wc-construct-stamina" data-tooltip="{{staminaLabel}}">{{staminaLabel}}</span>
            </div>
            {{#if stamina.label}}
            <div class="wc-bar" data-tooltip="{{staminaLabel}}"><span style="width: {{stamina.pct}}%"></span></div>
            {{/if}}
            <div class="wc-construct-meta">
              {{#if compilerLabel}}<span class="wc-dim" title="{{compilerName}}" data-tooltip="{{compilerLabel}}">{{compilerLabel}}</span>{{/if}}
              {{#if faceLabel}}<span class="wc-tag wc-face" data-tooltip="{{faceLabel}}">{{faceLabel}}</span>{{/if}}
            </div>
            <div class="wc-construct-actions">
              <button type="button" class="wc-btn wc-btn-small" data-action="selectConstruct" data-actor-uuid="{{uuid}}" {{disabled (not anchored)}} data-tooltip="{{panTooltip}}" aria-label="{{panTooltip}}">
                <i class="fa-solid fa-location-crosshairs"></i>
              </button>
              {{#if owned}}
              <button type="button" class="wc-btn wc-btn-small" data-action="commandConstruct" data-actor-uuid="{{uuid}}" data-tooltip="{{commandTooltip}}" aria-label="{{localize "GHOSTWIRE.WiredConsole.Constructs.Command"}}">
                <i class="fa-solid fa-terminal"></i>
              </button>
              <button type="button" class="wc-btn wc-btn-small wc-btn-danger" data-action="decompileConstruct" data-actor-uuid="{{uuid}}" data-tooltip="GHOSTWIRE.WiredConsole.Constructs.Decompile" aria-label="{{localize "GHOSTWIRE.WiredConsole.Constructs.Decompile"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
              {{/if}}
            </div>
          </div>
        </li>
        {{else}}
        <li class="wc-empty">{{#if isGM}}{{localize "GHOSTWIRE.WiredConsole.Constructs.EmptyGM"}}{{else}}{{localize "GHOSTWIRE.WiredConsole.Constructs.EmptyPlayer"}}{{/if}}</li>
        {{/each}}
      </ul>
    </section>

    {{!-- Nodes --}}
    <section class="wc-panel wc-nodes">
      <h3 class="wc-panel-title">
        {{localize "GHOSTWIRE.WiredConsole.Nodes"}}
        {{#if isGM}}
        <span class="wc-title-actions">
          <button type="button" class="wc-btn wc-btn-small" data-action="addNode" data-tooltip="GHOSTWIRE.WiredConsole.AddNode" aria-label="{{localize "GHOSTWIRE.WiredConsole.AddNode"}}" {{disabled (not hasScene)}}>
            <i class="fa-solid fa-plus"></i>
          </button>
          <button type="button" class="wc-btn wc-btn-small" data-action="randomNode" data-tooltip="{{localize "GHOSTWIRE.WiredConsole.RandomNode"}}: {{stratumLabel}}" aria-label="{{localize "GHOSTWIRE.WiredConsole.RandomNode"}}" {{disabled (not hasScene)}}>
            <i class="fa-solid fa-dice"></i>
          </button>
          <button type="button" class="wc-btn wc-btn-small" data-action="addTemplate" data-tooltip="GHOSTWIRE.WiredConsole.AddTemplate" aria-label="{{localize "GHOSTWIRE.WiredConsole.AddTemplate"}}" {{disabled (not hasScene)}}>
            <i class="fa-solid fa-layer-group"></i>
          </button>
          <button type="button" class="wc-btn wc-btn-small" data-action="generateCluster" data-tooltip="GHOSTWIRE.WiredConsole.GenerateCluster" aria-label="{{localize "GHOSTWIRE.WiredConsole.GenerateCluster"}}" {{disabled (not hasScene)}}>
            <i class="fa-solid fa-diagram-project"></i>
          </button>
          <button type="button" class="wc-btn wc-btn-small" data-action="autoNodes" data-tooltip="GHOSTWIRE.WiredConsole.AutoNodesHint" aria-label="{{localize "GHOSTWIRE.WiredConsole.AutoNodes"}}" {{disabled (not hasScene)}}>
            <i class="fa-solid fa-lightbulb"></i>
          </button>
          <button type="button" class="wc-btn wc-btn-small" data-action="addWireKit" data-tooltip="GHOSTWIRE.WiredKit.Hud" aria-label="{{localize "GHOSTWIRE.WiredKit.Button"}}">
            <i class="fa-solid fa-user-secret"></i>
          </button>
        </span>
        {{/if}}
      </h3>
      <ul class="wc-node-list">
        {{#each nodes}}
        <li class="wc-node {{#if selected}}selected{{/if}} {{#if down}}down{{/if}}" data-node-id="{{id}}" data-action="selectNode">
          <div class="wc-node-head">
            {{#if ../isGM}}<i class="wc-reveal fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"
              data-tooltip="{{#if revealed}}{{localize "GHOSTWIRE.WiredConsole.Revealed"}}{{else}}{{localize "GHOSTWIRE.WiredConsole.Hidden"}}{{/if}}"></i>{{/if}}
            <span class="wc-node-name" title="{{name}}" data-tooltip="{{name}}">{{name}}</span>
            <span class="wc-tag">T{{track}}</span>
            <span class="wc-tag">R{{rating}}</span>
            {{#if placed}}{{#if ../isGM}}<i class="fa-solid fa-location-dot wc-dim" data-tooltip="GHOSTWIRE.WiredConsole.OnCanvas"></i>{{/if}}{{/if}}
            {{#if down}}<span class="wc-tag wc-tag-down">{{localize "GHOSTWIRE.WiredConsole.Down"}}</span>{{/if}}
          </div>
          {{#if isTrack2}}
          <div class="wc-bar" data-tooltip="{{integrity}} / {{integrityMax}}"><span style="width: {{integrityPct}}%"></span></div>
          {{/if}}
          <div class="wc-alert-mini band-{{alertBand}}">
            {{#each alertSteps}}<span class="{{#if lit}}lit{{/if}} band-{{band}}"></span>{{/each}}
          </div>
        </li>
        {{else}}
        <li class="wc-empty">{{#if isGM}}{{localize "GHOSTWIRE.WiredConsole.NoNodesGM"}}{{else}}{{localize "GHOSTWIRE.WiredConsole.NoNodesPlayer"}}{{/if}}</li>
        {{/each}}
      </ul>
    </section>

    {{!-- Selected node --}}
    <section class="wc-panel wc-detail">
      {{#with selected}}
      <div class="wc-detail-inner" data-node-id="{{id}}">
        <div class="wc-detail-head">
          {{#if ../isGM}}
          <input type="text" class="wc-input wc-name-input" data-field="name" value="{{name}}">
          {{else}}
          <h3 class="wc-detail-name">{{name}}</h3>
          {{/if}}
          {{#if lockout}}<span class="wc-tag wc-tag-down">{{localize "GHOSTWIRE.WiredConsole.Lockout"}}</span>{{/if}}
        </div>

        <div class="wc-grid">
          <label>{{localize "GHOSTWIRE.WiredConsole.Track"}}</label>
          {{#if ../isGM}}
          <select class="wc-input" data-field="track">
            {{#each trackOptions}}<option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{else}}
          <span>{{#if isTrack2}}{{localize "GHOSTWIRE.WiredConsole.Track2"}}{{else}}{{localize "GHOSTWIRE.WiredConsole.Track1"}}{{/if}}</span>
          {{/if}}

          <label>{{localize "GHOSTWIRE.WiredConsole.Rating"}}</label>
          {{#if ../isGM}}
          <select class="wc-input" data-field="rating">
            {{#each ratingOptions}}<option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{else}}
          <span>R{{rating}}</span>
          {{/if}}

          <label>{{localize "GHOSTWIRE.WiredConsole.TokenStyle"}}</label>
          {{#if ../isGM}}
          <select class="wc-input" data-field="tokenStyle">
            {{#each tokenStyleOptions}}<option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{else}}
          <span>{{#if tokenStyle}}{{tokenStyle}}{{else}}{{localize "GHOSTWIRE.WiredConsole.TokenStyleGeneric"}}{{/if}}</span>
          {{/if}}

          <label>{{localize "GHOSTWIRE.WiredConsole.BreachDC"}}</label>
          <span>{{breachDC}} <em class="wc-dim">{{localize "GHOSTWIRE.WiredConsole.BreachDCHint"}}</em></span>

          <label>{{localize "GHOSTWIRE.WiredConsole.Ice"}}</label>
          <span>{{ice}}</span>

          {{#if isTrack2}}
          <label>{{localize "GHOSTWIRE.WiredConsole.Biofeedback"}}</label>
          <span>{{biofeedback}} <em class="wc-dim">({{localize "GHOSTWIRE.Wired.States.overlay"}} {{biofeedbackOverlay}} · {{localize "GHOSTWIRE.Wired.States.jackedIn"}} {{biofeedbackJackedIn}})</em></span>
          {{/if}}
        </div>

        {{#if isTrack2}}
        <div class="wc-block">
          <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.Integrity"}} <span class="wc-readout">{{integrity}} / {{integrityMax}}</span></div>
          <div class="wc-bar wc-bar-large"><span style="width: {{integrityPct}}%"></span></div>
          {{#if ../isGM}}
          <div class="wc-row">
            <input type="number" class="wc-input wc-amount" name="integrityAmount" min="0" step="1" value="1">
            <button type="button" class="wc-btn wc-btn-hot" data-action="damageIntegrity"><i class="fa-solid fa-bolt"></i> {{localize "GHOSTWIRE.WiredConsole.Damage"}}</button>
            <button type="button" class="wc-btn" data-action="restoreIntegrity"><i class="fa-solid fa-rotate-left"></i> {{localize "GHOSTWIRE.WiredConsole.Restore"}}</button>
          </div>
          {{/if}}
        </div>
        {{else}}
        <p class="wc-dim">{{localize "GHOSTWIRE.WiredConsole.Track1Hint"}}</p>
        {{/if}}

        <div class="wc-block">
          <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.TraceAlert"}} <span class="wc-readout band-{{alertBand}}">{{alert}} / 12</span></div>
          <div class="wc-alert">
            {{#each alertSteps}}<span class="{{#if lit}}lit{{/if}} band-{{band}}">{{step}}</span>{{/each}}
          </div>
          <p class="wc-alert-label band-{{alertBand}}">{{alertLabel}}</p>
          {{#if ../isGM}}
          <div class="wc-row">
            <button type="button" class="wc-btn" data-action="alertDown"><i class="fa-solid fa-minus"></i></button>
            <button type="button" class="wc-btn" data-action="alertUp"><i class="fa-solid fa-plus"></i> {{localize "GHOSTWIRE.WiredConsole.AlertUp"}}</button>
            <button type="button" class="wc-btn wc-btn-danger" data-action="alertMax"><i class="fa-solid fa-satellite-dish"></i> {{localize "GHOSTWIRE.WiredConsole.AlertMax"}}</button>
            {{#if lockout}}
            <button type="button" class="wc-btn" data-action="alertReset"><i class="fa-solid fa-rotate"></i> {{localize "GHOSTWIRE.WiredConsole.AlertReset"}}</button>
            {{/if}}
          </div>
          {{/if}}
        </div>

        {{#if ../isGM}}
        <div class="wc-block">
          <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.Description"}}</div>
          <textarea class="wc-input wc-notes" data-field="description" rows="3" placeholder="{{localize "GHOSTWIRE.WiredConsole.DescriptionPlaceholder"}}">{{description}}</textarea>
        </div>
        {{else if description}}
        <div class="wc-block">
          <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.Description"}}</div>
          <p class="wc-description">{{description}}</p>
        </div>
        {{/if}}

        {{#if ../isGM}}
        <div class="wc-block">
          <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.Links"}} <span class="wc-readout">{{links.length}}</span></div>
          {{#if linkOptions.length}}
          <ul class="wc-links">
            {{#each linkOptions}}
            <li>
              <label class="wc-link{{#if hidden}} is-hidden{{/if}}">
                <input type="checkbox" data-link-to="{{id}}" {{checked linked}}>
                <span class="wc-link-name">{{name}}</span>
                <span class="wc-tag">R{{rating}}</span>
                {{#if hidden}}<i class="fa-solid fa-eye-slash wc-dim" data-tooltip="GHOSTWIRE.WiredConsole.Hidden"></i>{{/if}}
              </label>
            </li>
            {{/each}}
          </ul>
          <p class="wc-dim wc-links-hint">{{localize "GHOSTWIRE.WiredConsole.LinksHint"}}</p>
          {{else}}
          <p class="wc-dim wc-links-hint">{{localize "GHOSTWIRE.WiredConsole.LinksNone"}}</p>
          {{/if}}
        </div>

        <div class="wc-block">
          <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.Notes"}}</div>
          <textarea class="wc-input wc-notes" data-field="notes" rows="4" placeholder="{{localize "GHOSTWIRE.WiredConsole.NotesPlaceholder"}}">{{notes}}</textarea>
          <div class="wc-row">
            <button type="button" class="wc-btn" data-action="toggleReveal">
              {{#if revealed}}<i class="fa-solid fa-eye-slash"></i> {{localize "GHOSTWIRE.WiredConsole.HideFromPlayers"}}{{else}}<i class="fa-solid fa-eye"></i> {{localize "GHOSTWIRE.WiredConsole.RevealToPlayers"}}{{/if}}
            </button>
            {{#if placed}}
            <button type="button" class="wc-btn" data-action="removeNode"><i class="fa-solid fa-circle-xmark"></i> {{localize "GHOSTWIRE.WiredConsole.RemoveFromCanvas"}}</button>
            {{else}}
            <button type="button" class="wc-btn" data-action="placeNode"><i class="fa-solid fa-location-dot"></i> {{localize "GHOSTWIRE.WiredConsole.PlaceOnCanvas"}}</button>
            {{/if}}
            <button type="button" class="wc-btn wc-btn-danger" data-action="deleteNode"><i class="fa-solid fa-trash"></i> {{localize "GHOSTWIRE.WiredConsole.DeleteNode"}}</button>
          </div>
        </div>
        {{/if}}
      </div>
      {{else}}
      <p class="wc-empty">{{localize "GHOSTWIRE.WiredConsole.NoSelection"}}</p>
      {{/with}}
    </section>
  </div>

  {{!-- Wire ping / spoof (B106): log is Scene-flagged; anyone with Console open sees it. Compose is GM-only. --}}
  <section class="wc-panel wc-pings">
    <h3 class="wc-panel-title">{{localize "GHOSTWIRE.WiredConsole.Pings"}}</h3>
    <ul class="wc-ping-log">
      {{#each pings}}
      <li class="wc-ping{{#if whisper}} is-whisper{{/if}}">
        <span class="wc-ping-meta">
          {{#if timeLabel}}<time>{{timeLabel}}</time>{{/if}}
          <span class="wc-tag">{{modeLabel}}</span>
          {{#if user}}<span class="wc-dim">{{user}}</span>{{/if}}
        </span>
        <span class="wc-ping-text">{{text}}</span>
      </li>
      {{else}}
      <li class="wc-empty">{{localize "GHOSTWIRE.WiredConsole.PingEmptyLog"}}</li>
      {{/each}}
    </ul>
    {{#if isGM}}
    <div class="wc-ping-compose">
      <input type="text" class="wc-input wc-ping-input" data-ping-text maxlength="{{pingMax}}" value="{{pingDraft}}" placeholder="{{localize "GHOSTWIRE.WiredConsole.PingPlaceholder"}}" {{disabled (not hasScene)}}>
      <select class="wc-input wc-ping-chat" data-ping-chat {{disabled (not hasScene)}}>
        <option value="public" {{#unless pingWhisper}}selected{{/unless}}>{{localize "GHOSTWIRE.WiredConsole.PingPublic"}}</option>
        <option value="whisper" {{#if pingWhisper}}selected{{/if}}>{{localize "GHOSTWIRE.WiredConsole.PingWhisper"}}</option>
      </select>
      <button type="button" class="wc-btn" data-action="sendPing" {{disabled (not hasScene)}}>
        <i class="fa-solid fa-satellite-dish"></i> {{localize "GHOSTWIRE.WiredConsole.PingSend"}}
      </button>
    </div>
    {{/if}}
  </section>
</div>

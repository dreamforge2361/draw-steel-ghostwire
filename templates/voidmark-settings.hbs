<div class="vm-settings-body">
  <p class="hint">{{localize "GHOSTWIRE.Voidmark.Settings.Menu.Intro"}}</p>
  <div class="form-group">
    <label for="vm-set-base">{{localize "GHOSTWIRE.Voidmark.Settings.ApiBaseUrl.Name"}}</label>
    <input id="vm-set-base" type="text" name="apiBaseUrl" value="{{apiBaseUrl}}" placeholder="https://api.x.ai/v1">
    <p class="hint">{{localize "GHOSTWIRE.Voidmark.Settings.ApiBaseUrl.Hint"}}</p>
  </div>
  <div class="form-group">
    <label for="vm-set-model">{{localize "GHOSTWIRE.Voidmark.Settings.Model.Name"}}</label>
    <input id="vm-set-model" type="text" name="model" value="{{model}}">
    <p class="hint">{{localize "GHOSTWIRE.Voidmark.Settings.Model.Hint"}}</p>
  </div>
  <div class="form-group">
    <label for="vm-set-temp">{{localize "GHOSTWIRE.Voidmark.Settings.Temperature.Name"}}</label>
    <input id="vm-set-temp" type="number" name="temperature" min="0" max="2" step="0.1" value="{{temperature}}">
  </div>
  <div class="form-group">
    <label for="vm-set-tokens">{{localize "GHOSTWIRE.Voidmark.Settings.MaxTokens.Name"}}</label>
    <input id="vm-set-tokens" type="number" name="maxTokens" min="256" max="4096" step="64" value="{{maxTokens}}">
  </div>
  <div class="form-group">
    <label for="vm-set-system">{{localize "GHOSTWIRE.Voidmark.Settings.SystemInstructions.Name"}}</label>
    <textarea id="vm-set-system" name="systemInstructions" rows="18">{{systemInstructions}}</textarea>
    <p class="hint">{{localize "GHOSTWIRE.Voidmark.Settings.SystemInstructions.Hint"}}</p>
  </div>
  <p class="hint">{{localize "GHOSTWIRE.Voidmark.Settings.KeyReminder"}}</p>
  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-check"></i> {{localize "GHOSTWIRE.Voidmark.Settings.Save"}}</button>
  </footer>
</div>

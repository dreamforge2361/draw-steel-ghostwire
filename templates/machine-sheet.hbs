<form class="ghostwire-machine-sheet flexcol" autocomplete="off">
  <header class="gw-m-header flexrow">
    <div class="gw-m-portrait">
      <a data-action="editImage" title="{{localize 'GHOSTWIRE.Summons.Machines.UI.PortraitHint'}}">
        <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" />
      </a>
      <div class="gw-m-token-row flexrow">
        <img class="token-art" src="{{tokenImg}}" alt="token" />
        <button type="button" data-action="editToken"><i class="fa-solid fa-circle-user"></i> {{localize "GHOSTWIRE.Summons.Machines.UI.TokenArt"}}</button>
      </div>
    </div>
    <div class="gw-m-identity flexcol">
      <input class="gw-m-name" type="text" name="name" value="{{actor.name}}" />
      <div class="gw-m-kind flexrow">
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Kind"}}
          <select name="flags.draw-steel-ghostwire.machine.kind">
            <option value="drone" {{#if (eq machine.kind "drone")}}selected{{/if}}>{{localize "GHOSTWIRE.Summons.Machines.UI.KindDrone"}}</option>
            <option value="vehicle" {{#if (eq machine.kind "vehicle")}}selected{{/if}}>{{localize "GHOSTWIRE.Summons.Machines.UI.KindVehicle"}}</option>
            <option value="baseAsset" {{#if (eq machine.kind "baseAsset")}}selected{{/if}}>{{localize "GHOSTWIRE.Summons.Machines.UI.KindBaseAsset"}}</option>
          </select>
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Band"}}
          <input type="text" name="flags.draw-steel-ghostwire.band" value="{{band}}" />
        </label>
      </div>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Tags"}}
        <input type="text" name="flags.draw-steel-ghostwire.machine.tags" value="{{tags}}" />
      </label>
    </div>
  </header>

  <nav class="gw-m-tabs flexrow">
    <a data-action="tab" data-tab="combat" class="{{#if (eq tab "combat")}}active{{/if}}">{{localize "GHOSTWIRE.Summons.Machines.UI.TabCombat"}}</a>
    <a data-action="tab" data-tab="control" class="{{#if (eq tab "control")}}active{{/if}}">{{localize "GHOSTWIRE.Summons.Machines.UI.TabControl"}}</a>
    <a data-action="tab" data-tab="build" class="{{#if (eq tab "build")}}active{{/if}}">{{localize "GHOSTWIRE.Summons.Machines.UI.TabBuild"}}</a>
    <a data-action="tab" data-tab="inventory" class="{{#if (eq tab "inventory")}}active{{/if}}">{{localize "GHOSTWIRE.Summons.Machines.UI.TabInventory"}}</a>
    <a data-action="tab" data-tab="links" class="{{#if (eq tab "links")}}active{{/if}}">{{localize "GHOSTWIRE.Summons.Machines.UI.TabLinks"}}</a>
    <a data-action="tab" data-tab="story" class="{{#if (eq tab "story")}}active{{/if}}">{{localize "GHOSTWIRE.Summons.Machines.UI.TabStory"}}</a>
  </nav>

  <section class="gw-m-body">
    {{#if (eq tab "combat")}}
    <div class="gw-m-grid">
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Integrity"}}
        <div class="flexrow gap">
          <input type="number" name="system.stamina.value" value="{{stamina.value}}" />
          <span>/</span>
          <input type="number" name="system.stamina.max" value="{{stamina.max}}" />
        </div>
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.SizeScale"}}
        <input type="text" name="flags.draw-steel-ghostwire.machine.sizeScale" value="{{machine.sizeScale}}" />
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Speed"}}
        <input type="number" name="system.movement.value" value="{{movement.value}}" />
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.MovementMode"}}
        <input type="text" name="flags.draw-steel-ghostwire.machine.movementMode" value="{{machine.movementMode}}" />
      </label>
    </div>
    {{/if}}

    {{#if (eq tab "control")}}
    <div class="gw-m-grid">
      <label class="checkbox">
        <input type="checkbox" name="flags.draw-steel-ghostwire.machine.jumpInCapable" {{checked machine.jumpInCapable}} />
        {{localize "GHOSTWIRE.Summons.Machines.UI.JumpInCapable"}}
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.ControlMode"}}
        <input type="text" name="flags.draw-steel-ghostwire.machine.controlMode" value="{{machine.controlMode}}" />
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Handling"}}
        <input type="text" name="flags.draw-steel-ghostwire.machine.handling" value="{{machine.handling}}" />
      </label>
      <div class="gw-m-actions flexrow">
        <button type="button" data-action="jumpIn" {{#unless canJumpIn}}disabled{{/unless}}><i class="fa-solid fa-plug"></i> {{localize "GHOSTWIRE.Summons.Machines.UI.JumpIn"}}</button>
        <button type="button" data-action="jumpOut" {{#unless jumpedIn}}disabled{{/unless}}><i class="fa-solid fa-plug-circle-xmark"></i> {{localize "GHOSTWIRE.Summons.Machines.UI.JumpOut"}}</button>
      </div>
    </div>
    {{/if}}

    {{#if (eq tab "build")}}
    <div class="gw-m-grid">
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Echelon"}}
        <input type="number" name="flags.draw-steel-ghostwire.echelon" value="{{echelon}}" min="1" max="4" />
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Domain"}}
        <input type="text" name="flags.draw-steel-ghostwire.machine.domain" value="{{machine.domain}}" />
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.ModSlots"}}
        <input type="number" name="flags.draw-steel-ghostwire.machine.modSlots" value="{{machine.modSlots}}" />
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.InstalledMods"}}
        <textarea name="flags.draw-steel-ghostwire.machine.installedModsText" rows="3">{{machine.installedModsText}}</textarea>
      </label>
    </div>
    {{/if}}

    {{#if (eq tab "inventory")}}
    <div class="gw-m-grid">
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Cargo"}}
        <textarea name="flags.draw-steel-ghostwire.machine.cargo" rows="2">{{machine.cargo}}</textarea>
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Mounts"}}
        <textarea name="flags.draw-steel-ghostwire.machine.mounts" rows="2">{{machine.mounts}}</textarea>
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Sensors"}}
        <textarea name="flags.draw-steel-ghostwire.machine.sensors" rows="2">{{machine.sensors}}</textarea>
      </label>
    </div>
    {{/if}}

    {{#if (eq tab "links")}}
    <div class="gw-m-grid">
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.OwnerUuid"}}
        <input type="text" name="flags.draw-steel-ghostwire.ownerUuid" value="{{ownerUuid}}" />
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.GearItemUuid"}}
        <input type="text" name="flags.draw-steel-ghostwire.gearItemUuid" value="{{gearItemUuid}}" />
      </label>
      <label class="checkbox">
        <input type="checkbox" name="flags.draw-steel-ghostwire.machine.homeGround" {{checked machine.homeGround}} />
        {{localize "GHOSTWIRE.Summons.Machines.UI.HomeGround"}}
      </label>
      <label class="checkbox">
        <input type="checkbox" name="flags.draw-steel-ghostwire.machine.beacon" {{checked machine.beacon}} />
        {{localize "GHOSTWIRE.Summons.Machines.UI.Beacon"}}
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Profile"}}
        <textarea name="flags.draw-steel-ghostwire.machine.profile" rows="3">{{machine.profile}}</textarea>
      </label>
    </div>
    {{/if}}

    {{#if (eq tab "story")}}
    <div class="gw-m-story flexcol">
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Description"}}
        <textarea name="system.biography.value" rows="8">{{biography}}</textarea>
      </label>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Notes"}}
        <textarea name="system.biography.director" rows="6">{{notes}}</textarea>
      </label>
    </div>
    {{/if}}
  </section>

  <footer class="gw-m-footer flexrow">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "Save Changes"}}</button>
  </footer>
</form>

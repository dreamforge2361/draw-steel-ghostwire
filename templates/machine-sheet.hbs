{{!-- Core (v14) toggles .active on nav [data-group] and .tab[data-group] without a re-render, so every
      panel stays in the DOM and a Save from any tab writes every field. --}}
<form class="ghostwire-machine-sheet flexcol" autocomplete="off">
  <header class="gw-m-header flexrow">
    <div class="gw-m-art flexrow">
      <figure class="gw-m-portrait">
        <img class="profile" data-action="editImage" data-edit="img" src="{{actor.img}}" alt="{{actor.name}}"
             title="{{localize 'GHOSTWIRE.Summons.Machines.UI.PortraitHint'}}" />
        <figcaption>{{localize "GHOSTWIRE.Summons.Machines.UI.Portrait"}}</figcaption>
      </figure>
      <figure class="gw-m-token">
        <img class="token-art" data-action="editImage" data-edit="prototypeToken.texture.src" src="{{tokenImg}}"
             alt="{{localize 'GHOSTWIRE.Summons.Machines.UI.TokenArt'}}"
             title="{{localize 'GHOSTWIRE.Summons.Machines.UI.TokenArtHint'}}" />
        <figcaption>{{localize "GHOSTWIRE.Summons.Machines.UI.TokenArt"}}</figcaption>
      </figure>
    </div>
    <div class="gw-m-identity flexcol">
      <input class="gw-m-name" type="text" name="name" value="{{actor.name}}" />
      <div class="gw-m-kind flexrow">
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Kind"}}
          <select name="flags.draw-steel-ghostwire.machine.kind">
            <option value="drone" {{#if (eq machine.kind "drone")}}selected{{/if}}>{{localize "GHOSTWIRE.Summons.Machines.UI.KindDrone"}}</option>
            <option value="vehicle" {{#if (eq machine.kind "vehicle")}}selected{{/if}}>{{localize "GHOSTWIRE.Summons.Machines.UI.KindVehicle"}}</option>
            <option value="baseAsset" {{#if (eq machine.kind "baseAsset")}}selected{{/if}}>{{localize "GHOSTWIRE.Summons.Machines.UI.KindBaseAsset"}}</option>
          </select>
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Band"}}
          <input type="text" name="flags.draw-steel-ghostwire.band" value="{{band}}" />
        </label>
      </div>
      <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Tags"}}
        <input type="text" name="flags.draw-steel-ghostwire.machine.tags" value="{{tags}}" />
      </label>
    </div>
  </header>

  <nav class="tabs gw-m-tabs flexrow" data-group="primary">
    {{#each tabs as |t|}}
    <button type="button" class="item {{t.cssClass}}" data-action="tab" data-group="{{t.group}}" data-tab="{{t.id}}"
            aria-pressed="{{#if t.active}}true{{else}}false{{/if}}">{{localize t.label}}</button>
    {{/each}}
  </nav>

  <section class="gw-m-body">
    <section class="tab gw-m-tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
      <div class="gw-m-grid">
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Integrity"}}
          <div class="flexrow gap">
            <input type="number" name="system.stamina.value" value="{{stamina.value}}" />
            <span>/</span>
            <input type="number" name="system.stamina.max" value="{{stamina.max}}" />
          </div>
        </label>
        {{!-- 0.3.122: the damage band Integrity puts this frame in. One band at a time, worst wins. --}}
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Condition"}}
          <span class="gw-m-condition condition-{{conditionId}}" data-tooltip="{{localize 'GHOSTWIRE.Summons.Machines.UI.ConditionHint'}}">{{conditionLabel}}</span>
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.SizeScale"}}
          <input type="text" name="flags.draw-steel-ghostwire.machine.sizeScale" value="{{machine.sizeScale}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Speed"}}
          <input type="number" name="system.movement.value" value="{{movement.value}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.MovementMode"}}
          <input type="text" name="flags.draw-steel-ghostwire.machine.movementMode" value="{{machine.movementMode}}" />
        </label>
      </div>
    </section>

    <section class="tab gw-m-tab {{tabs.control.cssClass}}" data-group="primary" data-tab="control">
      <div class="gw-m-grid">
        <label class="checkbox">
          <input type="checkbox" name="flags.draw-steel-ghostwire.machine.jumpInCapable" {{checked machine.jumpInCapable}} />
          {{localize "GHOSTWIRE.Summons.Machines.UI.JumpInCapable"}}
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.ControlMode"}}
          <input type="text" name="flags.draw-steel-ghostwire.machine.controlMode" value="{{machine.controlMode}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Handling"}}
          <input type="text" name="flags.draw-steel-ghostwire.machine.handling" value="{{machine.handling}}" />
        </label>
        <div class="gw-m-actions flexrow">
          <button type="button" data-action="jumpIn" {{#unless canJumpIn}}disabled{{/unless}}><i class="fa-solid fa-plug"></i> {{localize "GHOSTWIRE.Summons.Machines.UI.JumpIn"}}</button>
          <button type="button" data-action="jumpOut" {{#unless jumpedIn}}disabled{{/unless}}><i class="fa-solid fa-plug-circle-xmark"></i> {{localize "GHOSTWIRE.Summons.Machines.UI.JumpOut"}}</button>
        </div>
      </div>
    </section>

    <section class="tab gw-m-tab {{tabs.build.cssClass}}" data-group="primary" data-tab="build">
      <div class="gw-m-grid">
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Echelon"}}
          <input type="number" name="flags.draw-steel-ghostwire.echelon" value="{{echelon}}" min="1" max="4" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Domain"}}
          <input type="text" name="flags.draw-steel-ghostwire.machine.domain" value="{{machine.domain}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.ModSlots"}}
          <input type="number" name="flags.draw-steel-ghostwire.machine.modSlots" value="{{machine.modSlots}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Stations"}}
          <input type="text" name="flags.draw-steel-ghostwire.machine.stations" value="{{machine.stations}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Hardpoints"}}
          <input type="text" name="flags.draw-steel-ghostwire.machine.hardpoints" value="{{machine.hardpoints}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.InstalledMods"}}
          <textarea name="flags.draw-steel-ghostwire.machine.installedModsText" rows="3">{{machine.installedModsText}}</textarea>
        </label>
      </div>
    </section>

    <section class="tab gw-m-tab {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
      <div class="gw-m-inventory flexcol">
        <div class="gw-m-item-header flexrow">
          <span class="gw-m-item-title">{{localize "GHOSTWIRE.Summons.Machines.UI.EmbeddedItems"}}</span>
          {{#if editable}}
          <a class="gw-m-item-create" data-action="createItem" data-tooltip="{{localize 'GHOSTWIRE.Summons.Machines.UI.CreateItem'}}" aria-label="{{localize 'GHOSTWIRE.Summons.Machines.UI.CreateItem'}}">
            <i class="fa-solid fa-plus"></i>
          </a>
          {{/if}}
        </div>
        <ol class="gw-m-item-list">
          {{#each inventoryItems as |item|}}
          <li class="gw-m-item flexrow" data-item-id="{{item.id}}" data-document-uuid="{{item.uuid}}">
            <a class="gw-m-item-main flexrow" data-action="openItem" data-item-id="{{item.id}}">
              <img class="gw-m-item-img" src="{{item.img}}" alt="" />
              <span class="gw-m-item-name">{{item.name}}</span>
              <span class="gw-m-item-type">{{item.typeLabel}}</span>
              {{#if item.quantity}}
              <span class="gw-m-item-qty">&times;{{item.quantity}}</span>
              {{/if}}
            </a>
            {{#if ../editable}}
            <a class="gw-m-item-delete" data-action="deleteItem" data-item-id="{{item.id}}" data-tooltip="{{localize 'GHOSTWIRE.Summons.Machines.UI.DeleteItem'}}" aria-label="{{localize 'GHOSTWIRE.Summons.Machines.UI.DeleteItem'}}">
              <i class="fa-solid fa-trash"></i>
            </a>
            {{/if}}
          </li>
          {{else}}
          <li class="gw-m-item-empty">{{localize "GHOSTWIRE.Summons.Machines.UI.EmptyInventory"}}</li>
          {{/each}}
        </ol>
        <p class="gw-m-drop-hint">{{localize "GHOSTWIRE.Summons.Machines.UI.DropItemHint"}}</p>
        <details class="gw-m-inventory-notes">
          <summary>{{localize "GHOSTWIRE.Summons.Machines.UI.InventoryNotes"}}</summary>
          <div class="gw-m-grid">
            <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Cargo"}}
              <textarea name="flags.draw-steel-ghostwire.machine.cargo" rows="2">{{machine.cargo}}</textarea>
            </label>
            <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Mounts"}}
              <textarea name="flags.draw-steel-ghostwire.machine.mounts" rows="2">{{machine.mounts}}</textarea>
            </label>
            <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Sensors"}}
              <textarea name="flags.draw-steel-ghostwire.machine.sensors" rows="2">{{machine.sensors}}</textarea>
            </label>
          </div>
        </details>
      </div>
    </section>

    <section class="tab gw-m-tab {{tabs.links.cssClass}}" data-group="primary" data-tab="links">
      <div class="gw-m-grid">
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.OwnerUuid"}}
          <input type="text" name="flags.draw-steel-ghostwire.ownerUuid" value="{{ownerUuid}}" />
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.GearItemUuid"}}
          <input type="text" name="flags.draw-steel-ghostwire.gearItemUuid" value="{{gearItemUuid}}" />
        </label>
        <label class="checkbox">
          <input type="checkbox" name="flags.draw-steel-ghostwire.machine.homeGround" {{checked machine.homeGround}} />
          {{localize "GHOSTWIRE.Summons.Machines.UI.HomeGround"}}
        </label>
        <label class="checkbox">
          <input type="checkbox" name="flags.draw-steel-ghostwire.machine.beacon" {{checked machine.beacon}} />
          {{localize "GHOSTWIRE.Summons.Machines.UI.Beacon"}}
        </label>
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Profile"}}
          <textarea name="flags.draw-steel-ghostwire.machine.profile" rows="3">{{machine.profile}}</textarea>
        </label>
      </div>
    </section>

    <section class="tab gw-m-tab {{tabs.story.cssClass}}" data-group="primary" data-tab="story">
      <div class="gw-m-story flexcol">
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Description"}}</label>
        {{editor enrichedBiography target="system.biography.value" button=true editable=editable engine="prosemirror" collaborate=false}}
        {{!-- Director notes are gmOnly: a player's client never receives them, so never let a player
              submit the field back empty and wipe them. --}}
        {{#if isGM}}
        <label>{{localize "GHOSTWIRE.Summons.Machines.UI.Notes"}}</label>
        {{editor enrichedNotes target="system.biography.director" button=true editable=editable engine="prosemirror" collaborate=false}}
        {{/if}}
      </div>
    </section>
  </section>

  <footer class="gw-m-footer flexrow">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "GHOSTWIRE.Summons.Machines.UI.SaveChanges"}}</button>
  </footer>
</form>

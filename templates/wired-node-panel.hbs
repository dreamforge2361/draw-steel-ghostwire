<div class="wc-deck wn-deck">
  {{#if missing}}
  <p class="wc-empty">{{hint}}</p>
  {{else}}
  <header class="wn-head">
    {{#if img}}<img class="wn-img" src="{{img}}" alt="">{{/if}}
    <div class="wn-title">
      <h3 class="wn-name">{{name}}</h3>
      <p class="wn-tags">
        <span class="wc-tag">T{{track}}</span>
        <span class="wc-tag">R{{rating}}</span>
        {{#unless revealed}}<span class="wc-tag">{{localize "GHOSTWIRE.WiredConsole.Hidden"}}</span>{{/unless}}
        {{#if down}}<span class="wc-tag wc-tag-down">{{localize "GHOSTWIRE.WiredConsole.Down"}}</span>{{/if}}
      </p>
    </div>
  </header>

  <div class="wn-body">
    <section class="wc-panel wc-verbs">
      <h3 class="wc-panel-title">{{localize "GHOSTWIRE.WiredConsole.Verbs"}}</h3>
      <p class="wc-verb-status">
        {{#if runner}}
        <span class="wc-roster-name">{{runner.name}}</span>
        <span class="wc-state-chip state-{{runner.state}}">{{runner.stateLabel}}</span>
        {{else}}
        <span class="wc-dim">{{localize "GHOSTWIRE.WiredNode.NeedActor"}}</span>
        {{/if}}
      </p>
      {{!-- All nine Matrix Verbs. Connect while disconnected; the rest need Overlay / Jacked In. --}}
      <div class="wc-verb-strip">
        {{#each verbs}}
        <button type="button" class="wc-btn wc-verb" data-action="fireVerb" data-verb="{{dsid}}" {{disabled (not enabled)}} data-tooltip="{{tooltip}}">
          <i class="fa-solid {{icon}}"></i> {{label}}
        </button>
        {{/each}}
      </div>
      {{#if verbHint}}<p class="wc-dim wc-verb-hint">{{verbHint}}</p>{{/if}}
    </section>

    {{#if isTrack2}}
    <div class="wc-block">
      <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.Integrity"}} <span class="wc-readout">{{integrity}} / {{integrityMax}}</span></div>
      <div class="wc-bar wc-bar-large"><span style="width: {{integrityPct}}%"></span></div>
    </div>
    {{/if}}

    <div class="wc-block wn-alert-strip">
      <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.TraceAlert"}} <span class="wc-readout band-{{alertBand}}">{{alert}} / 12</span></div>
      <div class="wc-alert">
        {{#each alertSteps}}<span class="{{#if lit}}lit{{/if}}{{#if mark}} mark{{/if}} band-{{band}}">{{step}}</span>{{/each}}
      </div>
      {{!-- 0.3.143: the three steps the applet announces — 5 Malice, 9 hunt, 12 counter-trace. --}}
      <ul class="wn-alert-marks">
        {{#each alertMarks}}
        <li class="{{#if reached}}reached{{/if}}"><b>{{step}}</b> {{label}}</li>
        {{/each}}
      </ul>
      <p class="wc-alert-label band-{{alertBand}}">{{alertLabel}}</p>
      {{#if hunting}}<p class="wn-hunt-notice">{{huntNotice}}</p>{{/if}}
      {{#if canSurge}}
      <button type="button" class="wc-btn wc-btn-small wn-surge" data-action="maliceSurge" data-tooltip="{{surgeTooltip}}">
        <i class="fa-solid fa-skull"></i> {{surgeLabel}}
      </button>
      {{/if}}
    </div>

    {{!-- The Wire run checklist. Guidance only: it blocks nothing and rolls nothing. --}}
    <div class="wc-block wn-checklist{{#if checklistOpen}} open{{/if}}">
      <button type="button" class="wn-checklist-toggle" data-action="toggleChecklist" aria-expanded="{{#if checklistOpen}}true{{else}}false{{/if}}">
        <i class="fa-solid {{#if checklistOpen}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
        {{checklistTitle}}
      </button>
      {{#if checklistOpen}}
      <p class="wc-dim wn-checklist-hint">{{checklistHint}}</p>
      <ol class="wn-checklist-steps">
        {{#each checklist}}
        <li class="{{#if done}}done{{/if}}">
          <button type="button" class="wn-checklist-step" data-action="checkStep" data-step="{{id}}">
            <i class="fa-{{#if done}}solid fa-square-check{{else}}regular fa-square{{/if}}"></i>
            <span class="wn-checklist-label">{{labelText}}</span>
          </button>
          <span class="wn-checklist-cue">{{hintText}}</span>
        </li>
        {{/each}}
      </ol>
      {{/if}}
    </div>

    {{#if description}}
    <div class="wc-block">
      <div class="wc-block-title">{{localize "GHOSTWIRE.WiredConsole.Description"}}</div>
      <p class="wc-description">{{description}}</p>
    </div>
    {{/if}}
  </div>

  {{#if hasSheet}}
  <footer class="wn-foot">
    <button type="button" class="wc-btn wc-btn-small" data-action="openSheet">
      <i class="fa-solid fa-user"></i> {{localize "GHOSTWIRE.WiredNode.OpenSheet"}}
    </button>
  </footer>
  {{/if}}
  {{/if}}
</div>

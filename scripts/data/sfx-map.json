      "id": "wired-scan",
      "label": "Scan / ping",
      "match": "scan|ping|probe|trace",
      "src": "modules/draw-steel-ghostwire/assets/sfx/matrix-scan.ogg"
    },
    {
      "id": "wired",
      "label": "Wired / matrix / ICE / sprites",
      "keywords": [
        "wired"
      ],
      "match": "hack|intrusion|matrix|sprite|resonance|deck|program|ice|breach|node|signal|jack|compile|weav",

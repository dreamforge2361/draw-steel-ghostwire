{
  "_comment": "B40 SFX map. Custom module OGG under assets/sfx (mono vorbis q2). Rules tried in order; first match wins.",
  "default": "modules/draw-steel-ghostwire/assets/sfx/punch.ogg",
  "rules": [
    {
      "id": "wired",
      "label": "Wired / matrix / ICE / sprites",
      "keywords": [
        "wired"
      ],
      "match": "hack|intrusion|matrix|sprite|resonance|deck|program|ice|breach|node|signal|scan|ping|jack|compile|weav",
      "src": "modules/draw-steel-ghostwire/assets/sfx/matrix-connect.ogg"
    },
    {
      "id": "wired-scan",
      "label": "Scan / ping",
      "match": "scan|ping|probe|trace",
      "src": "modules/draw-steel-ghostwire/assets/sfx/matrix-scan.ogg"
    },
    {
      "id": "medic",
      "label": "Stim / inject / medical",
      "match": "stim|inject|patch|transfusion|stabiliz|anesthet|field adrenal|nano-adrenal|reagent",
      "src": "modules/draw-steel-ghostwire/assets/sfx/medic-inject.ogg"
    },
    {
      "id": "toxin",
      "label": "Toxin / chemical",
      "match": "toxin|chemical|nerve agent|toxic|poison|hiss",
      "src": "modules/draw-steel-ghostwire/assets/sfx/toxin-hiss.ogg"
    },
    {
      "id": "veil-heal",
      "label": "Holy / bless / heal",
      "keywords": [
        "magic",
        "psionic"
      ],
      "match": "heal|bless|lay on|grace|ward|light|sanctif|prayer",
      "src": "modules/draw-steel-ghostwire/assets/sfx/spell-holy-heal.ogg"
    },
    {
      "id": "veil-dark",
      "label": "Dark / pact / drain / smite",

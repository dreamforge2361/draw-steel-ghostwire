      "src": "modules/draw-steel-ghostwire/assets/sfx/spell-dark-blast.ogg"
    },
    {
      "id": "veil-element",
      "label": "Elemental / lightning / storm / fire",
      "match": "lightning|storm|hurl|element|fireball|fire blast|essence|channel",
      "src": "modules/draw-steel-ghostwire/assets/sfx/spell-lightning.ogg"
    },
    {
      "id": "veil-summon",
      "label": "Summon / spirit",
      "match": "summon|spirit|conjur",
      "src": "modules/draw-steel-ghostwire/assets/sfx/spell-summon.ogg"

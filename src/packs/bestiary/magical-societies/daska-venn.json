    },
    {
      "name": "The Dirty Return",
      "type": "feature",
      "_id": "gwBesDaskaVeIt03",
      "img": "icons/commodities/tech/console-steel.webp",
      "system": {
        "description": {
          "value": "<p>Exposed teams and equipment come back down a separate lane: check-in, isolation, wash-down, then documented transfer into the Sample Lock. Daska runs it personally.</p><p>She has an edge on tests to plan an extraction route, to bring an exposed crew back inside without spreading what they picked up, or to notice that a returning carrier's passenger count does not match the one she dispatched. The procedure is ordinary mechanical segregation and trained handling — there is no cleansing arch, and nothing here cures contamination.</p>",
          "director": ""
        },
        "source": {
          "book": "Ghostwire Core Rulebook",
          "page": "25-opposition",
          "license": "Draw Steel Creator License"
        },
        "_dsid": "the-dirty-return",
        "advancements": {},

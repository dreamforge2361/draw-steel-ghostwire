  "items": [
    {
      "name": "Remembers Every Name",
      "type": "feature",
      "_id": "gwBesTaviSorIt01",
      "img": "icons/sundries/books/book-worn-brown.webp",
      "system": {
        "description": {
          "value": "<p>Tavi can name everyone who has come through the Night Window in the last two years, what they needed, who they came in with, and roughly when they stopped coming — and why. She has an edge on tests to recognise a face, place a stranger in the neighbourhood, or notice that someone in the queue does not belong to it.</p><p>She keeps it in her head on purpose. There is no citywide shelter directory, and the Back Table holds current needs, not a master list.</p>",
          "director": ""
        },
        "source": {
          "book": "Ghostwire Core Rulebook",
          "page": "25-opposition",
          "license": "Draw Steel Creator License"
        },
        "_dsid": "remembers-every-name",

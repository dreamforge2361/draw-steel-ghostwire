          },
          {
            "uuid": "Compendium.draw-steel-ghostwire.classes.Item.BD9jUg8qhJutjOY5"
          }
        ],
        "description": "<p>Choose your discipline: <strong>Sprite-Weaver</strong> (go wide with more, cheaper sprites; biofeedback DC −2), <strong>Machine-Whisperer</strong> (interface and healer, the Cyborg-mending specialist), or <strong>Resonance-Warrior</strong> (offensive mystic; biofeedback DC +2). Each grants a skill: Summoning, Repair, or Security Systems. (<em>Quick Build:</em> Sprite-Weaver.)</p><p><strong>Cyborgs can’t be Technomancers</strong> (Arcane Severance).</p>",
        "chooseN": 1,
        "sort": 6000,
        "additional": {
          "type": "",
          "perkType": []
        }
